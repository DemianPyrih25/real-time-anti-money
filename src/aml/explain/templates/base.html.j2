<!doctype html>
{# The M6 case pages' shell: the results dashboard's tokens (ledger-grey neutrals, ink-navy
   accent), IBM Plex, light and dark (prefers-color-scheme, or data-theme on <html>).
   Rendered by aml.serving.app with autoescape on; data never reaches a script as markup. #}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&amp;family=IBM+Plex+Sans:wght@400;500;600;700&amp;display=swap">
<style>
{% raw %}
:root {
  --page: #f1f3f2; --surface: #fcfcfb; --surface-2: #f5f7f6; --ink: #0e1513; --ink-2: #4a5450;
  --muted: #747d79; --grid: #e3e6e3; --axis: #c3c9c5; --hair: rgba(14, 21, 19, .10);
  --accent: #1f3d63; --accent-wash: rgba(31, 61, 99, .08); --band: rgba(14, 21, 19, .045);
  --s-graph: #2a78d6; --s-ctx: #b6bdb9;
  --pos: #2a78d6; --neg: #e34948; --good: #0ca30c; --good-ink: #006300; --warn: #fab219; --crit: #d03b3b;
  --f-sans: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Consolas, monospace;
  --r: 10px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --page: #0e1110; --surface: #1a1a19; --surface-2: #212221; --ink: #f2f4f3; --ink-2: #c3c2b7;
    --muted: #8d948f; --grid: #2c2c2a; --axis: #3e413f; --hair: rgba(255, 255, 255, .10);
    --accent: #a9c2e6; --accent-wash: rgba(169, 194, 230, .10); --band: rgba(255, 255, 255, .045);
    --s-graph: #3987e5; --s-ctx: #4b514e;
    --pos: #3987e5; --neg: #e66767; --good-ink: #0ca30c; --crit: #e66767;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --page: #0e1110; --surface: #1a1a19; --surface-2: #212221; --ink: #f2f4f3; --ink-2: #c3c2b7;
  --muted: #8d948f; --grid: #2c2c2a; --axis: #3e413f; --hair: rgba(255, 255, 255, .10);
  --accent: #a9c2e6; --accent-wash: rgba(169, 194, 230, .10); --band: rgba(255, 255, 255, .045);
  --s-graph: #3987e5; --s-ctx: #4b514e;
  --pos: #3987e5; --neg: #e66767; --good-ink: #0ca30c; --crit: #e66767;
  color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { background: var(--page); color: var(--ink); font: 400 14px/1.5 var(--f-sans); margin: 0; }
a { color: var(--accent); text-underline-offset: 2px; }
a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.wrap { max-width: 1240px; margin: 0 auto; padding-inline: clamp(16px, 3vw, 32px); }
header.top { padding-block: 22px 14px; }
.back { display: inline-block; font-size: 13px; margin-bottom: 14px; text-decoration: none; }
.back:hover { text-decoration: underline; }
.eyebrow { font: 500 12px/1.4 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
h1 { font-size: clamp(22px, 3vw, 30px); line-height: 1.2; margin: 6px 0 8px; font-weight: 600; letter-spacing: -.01em; text-wrap: balance; }
.lede { max-width: 72ch; color: var(--ink-2); margin: 0; }
.chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 14px; }
.chip { display: inline-flex; align-items: center; gap: 6px; font: 500 12px/1 var(--f-sans); padding: 6px 10px; border-radius: 999px; background: var(--surface); border: 1px solid var(--hair); color: var(--ink-2); text-decoration: none; }
.chip b { color: var(--ink); font-weight: 600; }
a.chip:hover { background: var(--accent-wash); color: var(--ink); }
.pill { display: inline-flex; align-items: center; gap: 5px; font: 600 11px/1 var(--f-sans); letter-spacing: .03em; text-transform: uppercase; padding: 5px 8px; border-radius: 5px; border: 1px solid var(--hair); color: var(--ink-2); background: var(--surface-2); }
.pill.crit { color: var(--crit); border-color: color-mix(in srgb, var(--crit) 40%, transparent); }
.pill.crit::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
section { padding-block: 22px 6px; }
.sec-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px; margin-bottom: 12px; }
h2 { font-size: 19px; font-weight: 600; margin: 0; letter-spacing: -.005em; }
.sec-head p { margin: 0; color: var(--ink-2); max-width: 70ch; }
.grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
.s12 { grid-column: span 12; } .s7 { grid-column: span 7; } .s5 { grid-column: span 5; } .s4 { grid-column: span 4; } .s3 { grid-column: span 3; }
@media (max-width: 980px) { .s7, .s5, .s4 { grid-column: span 12; } .s3 { grid-column: span 6; } }
@media (max-width: 520px) { .s3 { grid-column: span 12; } }
.card { background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r); padding: 16px 18px 14px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.card-h { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.card-h h3 { margin: 0; font-size: 15px; font-weight: 600; line-height: 1.35; }
.card-h .sub { margin: 2px 0 0; color: var(--ink-2); font-size: 13px; }
.tag { font: 500 11px/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.foot { font-size: 12px; color: var(--muted); margin: 0; }
.mono { font-family: var(--f-mono); font-size: .92em; }
.tile { background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r); padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.tile .lab { font-size: 13px; color: var(--ink-2); }
.tile .val { font-size: 26px; font-weight: 600; line-height: 1.1; letter-spacing: -.01em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.tile .val small { font-size: 14px; font-weight: 500; color: var(--ink-2); }
.tile .sub { font-size: 12.5px; color: var(--muted); }
dl.kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 14px; margin: 0; font-size: 13.5px; }
dl.kv dt { color: var(--muted); }
dl.kv dd { margin: 0; font-weight: 500; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: var(--ink-2); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.sw { display: inline-block; flex: none; }
.sw.disc { width: 11px; height: 11px; border-radius: 50%; }
.sw.line { width: 18px; border-radius: 2px; }
.tablewrap { overflow-x: auto; }
table.data { border-collapse: collapse; width: 100%; font-size: 13px; font-variant-numeric: tabular-nums; }
table.data th, table.data td { text-align: right; padding: 7px 10px; border-bottom: 1px solid var(--grid); white-space: nowrap; }
table.data th:first-child, table.data td:first-child { text-align: left; }
table.data th { font-weight: 600; color: var(--ink-2); font-size: 12px; }
table.data td.l, table.data th.l { text-align: left; }
table.data tr.hl td { background: var(--accent-wash); }
.callout { background: var(--surface-2); border: 1px solid var(--hair); border-radius: var(--r); padding: 12px 14px; color: var(--ink-2); font-size: 13.5px; }
.callout b { color: var(--ink); }
footer.end { padding-block: 26px 40px; color: var(--muted); font-size: 12.5px; }
{% endraw %}
{% block style %}{% endblock %}
</style>
</head>
<body>
{% block header %}{% endblock %}
{% block content %}{% endblock %}
{% block scripts %}{% endblock %}
</body>
</html>
