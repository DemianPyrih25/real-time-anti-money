**/API.txt
.env
.env.*
!.env.example
.modal.toml
kaggle.json
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
CLAUDE.md
.claude/
*claude*
*Claude*
*CLAUDE*

# ---------------------------------------------------------------------------------------------
# Markdown: only the README is published; every other .md file stays local.
# ---------------------------------------------------------------------------------------------
*.md
!/README.md

# ---------------------------------------------------------------------------------------------
# Data, models and run outputs: everything on the Modal Volume is rebuilt from Kaggle + code.
# reports/ IS committed. Root-anchored folders so the packages src/aml/data/ (and later
# src/aml/serving/) stay tracked.
# ---------------------------------------------------------------------------------------------
/data/
/raw/
/parquet/
/labels/
/features/
/models/
/optuna/
/serving/
# Kaggle dataset files, anywhere (large, and raw rows carry calendar timestamps)
HI-*_Trans.csv
HI-*_Patterns.txt
LI-*_Trans.csv
LI-*_Patterns.txt
HI-*_accounts.csv
LI-*_accounts.csv
*.zip
# Ad-hoc extracts at the repo root
/*.csv
*.parquet
# Model artefacts and checkpoints
*.pt
*.pth
*.ckpt
*.onnx
booster_s*.txt
# MLflow / Optuna local stores
mlruns/
mlartifacts/
mlflow.db
optuna.db
# Scratch and partial files (aml.io writes ".<name>.tmp-<pid>" before os.replace)
synthetic_out/
scratch/
tmp/
*.part
.*.tmp-*
*.tmp
*.log

